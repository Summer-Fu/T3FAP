{
  "id": "task.quark_share_filter",
  "name": "夸克分享过滤转存",
  "version": "1.0.0",
  "category": "task",
  "description": "解析夸克网盘分享链接，按集数过滤后分批转存到个人网盘。最新N集保存在根目录，其余内容保存到「其他剧集」子文件夹。",
  "author": "T3FAP Community",
  "homepage": "https://github.com/qq85423296/T3FAP",
  "license": "MIT",
  "core_version": ">=1.0.0 <2.0.0",
  "contract_version": "1.0",
  "capabilities": [
    "task.template",
    "task.executor",
    "task.from_resource"
  ],
  "backend": {
    "entry": "backend.plugin:plugin"
  },
  "permissions": [
    "network",
    "task.dispatch"
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "config_schema": [
    {
      "key": "enabled",
      "label": "启用插件",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否启用夸克分享过滤转存插件。",
      "secret": false,
      "group": "基础设置"
    },
    {
      "key": "t3fap_host",
      "label": "T3FAP 服务地址",
      "type": "string",
      "required": false,
      "default": "http://127.0.0.1:8521",
      "description": "T3FAP 平台的 API 地址，用于调用网盘操作接口。插件运行在容器内时可留空使用默认值。",
      "secret": false,
      "group": "基础设置"
    },
    {
      "key": "t3fap_api_key",
      "label": "T3FAP API 密钥",
      "type": "string",
      "required": false,
      "default": "",
      "description": "T3FAP 平台的 API 密钥。可在平台设置中查看和管理。",
      "secret": true,
      "group": "基础设置"
    },
    {
      "key": "default_latest_n",
      "label": "默认最新 N 集",
      "type": "integer",
      "required": false,
      "default": 5,
      "min": 1,
      "description": "默认保存最新的 N 集到根目录。",
      "secret": false,
      "group": "过滤设置"
    },
    {
      "key": "others_folder_name",
      "label": "其他剧集文件夹名",
      "type": "string",
      "required": false,
      "default": "其他剧集",
      "description": "非最新 N 集的内容保存到哪个子文件夹。",
      "secret": false,
      "group": "过滤设置"
    },
    {
      "key": "video_extensions",
      "label": "视频文件扩展名",
      "type": "string",
      "required": false,
      "default": ".mp4,.mkv,.avi,.rmvb,.ts,.mov,.wmv,.flv,.m4v,.iso",
      "description": "识别为视频文件的扩展名列表，多个值用英文逗号分隔。只有视频文件才会被解析集数并参与过滤。",
      "secret": false,
      "group": "高级设置"
    }
  ],
  "ui": {
    "menus": [],
    "settings_sections": [
      {
        "key": "task.quark_share_filter",
        "title": "夸克分享过滤转存"
      }
    ],
    "task_templates": [
      "quark_share_filter"
    ]
  },
  "healthcheck": {
    "enabled": true,
    "interval_seconds": 300
  }
}
