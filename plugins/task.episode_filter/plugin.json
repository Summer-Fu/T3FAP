{
  "id": "task.episode_filter",
  "name": "网盘下载集数过滤器",
  "version": "1.0.0",
  "category": "task",
  "description": "针对网盘下载任务，支持按起始集数过滤、屏蔽指定集数/文件夹、只下载最新N集等灵活的集数筛选策略。所有订阅下载均可经过此插件过滤后再执行。",
  "author": "T3FAP Community",
  "homepage": "https://github.com/qq85423296/T3FAP",
  "license": "MIT",
  "core_version": ">=1.0.0 <2.0.0",
  "contract_version": "1.0",
  "capabilities": [
    "task.template",
    "task.executor",
    "task.from_resource"
  ],
  "backend": {
    "entry": "backend.plugin:plugin"
  },
  "permissions": [
    "task.dispatch"
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "config_schema": [
    {
      "key": "enabled",
      "label": "启用插件",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否启用网盘下载集数过滤器。",
      "secret": false,
      "group": "基础设置"
    },
    {
      "key": "default_filter_mode",
      "label": "默认过滤模式",
      "type": "string",
      "required": false,
      "default": "all",
      "description": "新建任务时的默认过滤模式。可选值：all（全部下载）、start_from（从指定集数开始）、latest_n（只下载最新N集）、exclude（屏蔽指定集数）、include_only（仅下载指定集数）、exclude_items（屏蔽指定文件/文件夹）。",
      "secret": false,
      "group": "基础设置"
    },
    {
      "key": "video_extensions",
      "label": "视频文件扩展名",
      "type": "string",
      "required": false,
      "default": ".mp4,.mkv,.avi,.rmvb,.ts,.mov,.wmv,.flv,.m4v,.iso",
      "description": "识别为视频文件的扩展名列表，多个值用英文逗号分隔。只有视频文件才会被解析集数并参与过滤。",
      "secret": false,
      "group": "高级设置"
    },
    {
      "key": "custom_episode_regex",
      "label": "自定义集数正则",
      "type": "string",
      "required": false,
      "default": "",
      "description": "自定义集数识别正则表达式。留空则使用内置多模式匹配。正则中第一个捕获组将被作为集数。",
      "secret": false,
      "group": "高级设置"
    }
  ],
  "ui": {
    "menus": [],
    "settings_sections": [
      {
        "key": "task.episode_filter",
        "title": "网盘下载集数过滤器"
      }
    ],
    "task_templates": [
      "episode_filter"
    ]
  },
  "healthcheck": {
    "enabled": true,
    "interval_seconds": 300
  }
}
