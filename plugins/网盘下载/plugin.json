{
  "id": "task.drive_download_filter",
  "name": "网盘下载集数过滤",
  "version": "0.1.0",
  "category": "task",
  "description": "在创建网盘下载任务时，提供集数范围选择和屏蔽功能。支持自动识别网盘内容中的集数编号，可设置起始/结束集数，或手动标记屏蔽不下载的内容，确保只下载需要的剧集。",
  "author": "T3FAP Community",
  "homepage": "",
  "license": "MIT",
  "core_version": ">=1.0.0 <2.0.0",
  "contract_version": "1.0",
  "capabilities": [
    "task.template",
    "task.executor",
    "task.from_resource"
  ],
  "backend": {
    "entry": "backend.plugin:plugin"
  },
  "permissions": [
    "task.dispatch"
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "config_schema": [
    {
      "key": "default_start_episode",
      "label": "默认起始集数",
      "type": "integer",
      "required": false,
      "default": 1,
      "description": "新建任务时默认的起始集数，留空表示从第1集开始。",
      "secret": false,
      "group": "默认设置"
    },
    {
      "key": "default_end_episode",
      "label": "默认结束集数",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "新建任务时默认的结束集数，0 表示不设上限（直到最新一集）。",
      "secret": false,
      "group": "默认设置"
    },
    {
      "key": "episode_patterns",
      "label": "集数识别正则",
      "type": "string",
      "required": false,
      "default": "[第\\s]*(\\d{1,4})[集话話期回]|\\bE?(\\d{1,4})\\b|-(\\d{1,4})\\s*\\[|\\[(\\d{1,4})\\]",
      "description": "用于从文件名或文件夹名中识别集数的正则表达式，多个模式用英文逗号分隔。默认已覆盖常见命名格式。",
      "secret": false,
      "group": "高级设置"
    },
    {
      "key": "auto_filter_enabled",
      "label": "启用自动过滤",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否在创建任务时自动应用集数过滤规则。关闭后需手动确认。",
      "secret": false,
      "group": "默认设置"
    }
  ],
  "ui": {
    "menus": [],
    "settings_sections": [
      {
        "key": "task.drive_download_filter",
        "title": "网盘下载集数过滤"
      }
    ],
    "task_templates": [
      "drive_download_filter"
    ]
  },
  "healthcheck": {
    "enabled": true,
    "interval_seconds": 300
  }
}
