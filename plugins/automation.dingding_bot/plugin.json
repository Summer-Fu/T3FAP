{
  "id": "automation.dingding_bot",
  "name": "钉钉 Bot",
  "version": "2.2.4",
  "category": "automation",
  "description": "监听任务和系统事件，通过钉钉群机器人发送通知消息。支持加签安全设置、@指定人。",
  "author": "T3FAP Community",
  "homepage": "",
  "license": "MIT",
  "core_version": ">=1.0.0 <2.0.0",
  "contract_version": "1.0",
  "capabilities": [
    "automation.event_handler",
    "notification.dingtalk"
  ],
  "backend": {
    "entry": "backend.plugin:plugin"
  },
  "permissions": [
    "network",
    "secret.read"
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "config_schema": [
    {
      "key": "enabled",
      "label": "启用插件",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "是否启用钉钉 Bot 通知自动化。",
      "secret": false,
      "group": "基础设置"
    },
    {
      "key": "webhook_url",
      "label": "机器人回调地址",
      "type": "string",
      "required": true,
      "default": "",
      "description": "钉钉群机器人的 webhook 回调地址。",
      "secret": true,
      "group": "基础设置"
    },
    {
      "key": "secret",
      "label": "加签密钥",
      "type": "string",
      "required": false,
      "default": "",
      "description": "启用安全加签时使用的签名密钥（以 SEC 开头）。如果是关键词或 IP 白名单模式，此项留空。",
      "secret": true,
      "group": "基础设置"
    },
    {
      "key": "enabled_events",
      "label": "启用事件列表",
      "type": "string",
      "required": false,
      "default": "task.completed,task.failed,task.started,task.created,task.canceled,task.transfer.post_execute,task.strm.post_execute,task.download.post_execute,task.drive_download.post_execute,task.video_download.post_execute,task.short_video.post_execute,task.drive_cache_keep.post_execute,task.subscription.post_execute,task.catalog_batch_strm.post_execute,task.live_catalog_batch_strm.post_execute,plugin.installed,plugin.uninstalled,system.startup,system.shutdown",
      "description": "需要发送通知的事件类型列表，多个值用英文逗号分隔。默认包含所有任务和系统事件。",
      "secret": false,
      "group": "通知设置"
    },
    {
      "key": "at_mobiles",
      "label": "提醒手机号列表",
      "type": "string",
      "required": false,
      "default": "",
      "description": "需要在钉钉消息中 @ 的手机号列表，多个值用英文逗号分隔。",
      "secret": false,
      "group": "通知设置"
    },
    {
      "key": "t3_api_base",
      "label": "T3 平台 API 地址",
      "type": "string",
      "required": false,
      "default": "https://t3.midsummer.asia:28888/api",
      "description": "T3 平台的 API 基础地址，例如 https://t3.midsummer.asia:28888/api。也可填写局域网地址。",
      "secret": false,
      "group": "高级设置"
    },
    {
      "key": "t3_api_key",
      "label": "T3 平台 API Key",
      "type": "string",
      "required": false,
      "default": "t3mt_QzuZ7KKiKA0rEfKYB5z6jk3ktmfLAWL3NpLgxYpJbrs",
      "description": "T3 平台的 API Key，用于调用平台接口获取任务详情和执行日志。",
      "secret": true,
      "group": "高级设置"
    },
    {
      "key": "t3_api_header",
      "label": "T3 平台 API 认证头",
      "type": "string",
      "required": false,
      "default": "X-API-Key",
      "description": "API 认证使用的 HTTP Header 名称，默认 X-API-Key（T3MT 平台标准）。",
      "secret": false,
      "group": "高级设置"
    }
  ],
  "ui": {
    "menus": [],
    "settings_sections": [
      {
        "key": "notification.dingtalk",
        "title": "钉钉 Bot 通知"
      }
    ],
    "task_templates": []
  },
  "healthcheck": {
    "enabled": true,
    "interval_seconds": 300
  }
}
